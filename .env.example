# Copy to .env — keys NEVER enter the repo (.env is gitignored).
#
# Everything here is optional. With an agent CLI (claude/codex/gemini) on your
# PATH the pipeline needs NO keys at all, and it runs end-to-end deterministic
# with GTM_LLM=none.

# ---- LLM backend -----------------------------------------------------------
# Read by llm.py. Backend auto-resolves: GTM_LLM if set, else an agent CLI on
# PATH ("cli"), else LLM_API_KEY ("api"), else "none" (deterministic only).

# Force a backend: cli | api | none. Leave blank to auto-detect.
GTM_LLM=

# "api" backend only — any OpenAI-compatible chat endpoint, incl. local servers.
LLM_API_KEY=
LLM_API_BASE=          # default: https://api.openai.com/v1
LLM_MODEL=             # default: gpt-4o-mini

# "cli" backend only — override which agent CLI is used. Leave blank to take
# the first of claude/codex/gemini found on PATH.
GTM_LLM_CLI=

# ---- Enrichment provider (terminal stage, gated) ---------------------------
# NOT read by any shipped code. The provider adapter is BYOK and you build it
# (see SETUP.md §8); this is the conventional slot for it to read.
FULLENRICH_API_KEY=

# Apollo has no HTTP client in this repo — discovery runs through your agent's
# own authenticated tooling (SETUP.md §0, §4). No key slot by design.
